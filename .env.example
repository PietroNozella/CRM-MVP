NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Server-only (nunca use prefixo NEXT_PUBLIC_). Usado em rotas API / server actions.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo do webhook de leads. Envie como Authorization: Bearer <segredo>.
# Se vazio, o webhook aceita sem auth (apenas para dev local).
LEADS_WEBHOOK_SECRET=gere-um-segredo-forte
