NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Server-only (nunca use prefixo NEXT_PUBLIC_). Usado em rotas API / server actions.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Marca do cliente (opcional, padrão "PRUMO"). Ver src/lib/site.ts.
NEXT_PUBLIC_APP_NAME=PRUMO

# Mensagem do botao Chamar no WhatsApp, use {nome} (opcional).
# NEXT_PUBLIC_WHATSAPP_TEMPLATE=Olá {nome}, obrigado pelo contato! Como posso ajudar?

# Fuso da instalacao para filtros e badges (opcional, padrao America/Sao_Paulo).
# NEXT_PUBLIC_TIME_ZONE=America/Sao_Paulo
